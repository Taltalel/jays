# Tal's Marketing Hub — environment variables.
# Real values go in Vercel → Project → Settings → Environment Variables
# (and in .env.local for running scripts locally). Never commit real values.
# The Integrations page lists each one with where to get it.

# --- Phase 1: required -------------------------------------------------------

# Supabase → Project Settings → API (a NEW project, not the Review Hub's)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Sign-in allowlist. Only these two Google accounts can sign in.
# After changing either, run `npm run owners` so the database agrees.
ALLOWED_EMAIL_PRIMARY=marketing@yesfbm.com
BACKUP_ADMIN_EMAIL=

# Public URL of the Hub, used for OAuth redirects (e.g. https://tal-marketing-hub.vercel.app)
APP_URL=

# Vercel Cron sends this as a Bearer token. Any long random string.
CRON_SECRET=

# console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=

# Google Cloud → APIs & Services → Credentials → OAuth client (Web).
# Also pasted into Supabase → Auth → Providers → Google for sign-in.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Shown once by Integrations → Gmail → Connect (scope: gmail.readonly).
GMAIL_REFRESH_TOKEN=
# Optional: first date to import receipts from (YYYY-MM-DD). Default 2026-01-01.
GMAIL_BACKFILL_FROM=
# Optional: inbox to read if different from ALLOWED_EMAIL_PRIMARY.
GMAIL_ACCOUNT=

